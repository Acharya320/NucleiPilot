# Copy this file to `.env` and fill in your real key. `.env` is gitignored --
# never commit a real key, and never show it in the demo video.
#
# The planner talks to ANY OpenAI-compatible /chat/completions endpoint, so the
# same code works with OpenRouter, OpenAI, Anthropic, or a local Ollama server.
#
# --- OpenRouter (default here) ---------------------------------------------
# One key, many models. Model IDs are namespaced "<provider>/<model>".
#   NUCLEIPILOT_API_BASE=https://openrouter.ai/api/v1
#   NUCLEIPILOT_MODEL=openai/gpt-4o-mini        # cheap + reliable JSON
#   # other good choices:
#   #   anthropic/claude-3.5-haiku
#   #   google/gemini-2.0-flash-001
#   #   meta-llama/llama-3.3-70b-instruct
#
# --- OpenAI direct ---------------------------------------------------------
#   NUCLEIPILOT_API_BASE=https://api.openai.com/v1
#   NUCLEIPILOT_MODEL=gpt-4o-mini
#
# --- Local Ollama (no key needed; any placeholder works) -------------------
#   NUCLEIPILOT_API_BASE=http://127.0.0.1:11434/v1
#   NUCLEIPILOT_MODEL=llama3.1:8b

NUCLEIPILOT_API_BASE=https://openrouter.ai/api/v1
NUCLEIPILOT_API_KEY=replace-me
NUCLEIPILOT_MODEL=openai/gpt-4o-mini
