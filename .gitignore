# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Secrets / environment ---
.env
.env.*
!.env.example

# --- Results: ignore scratch runs, keep only curated final evidence ---
results/*.json
results/*.csv
results/reproduced/
!results/final/

# --- Never commit protected assignment materials ---
*.pdf
!presentation/NucleiPilot_Executive_Deck.pdf

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Office lock/temp files (appear while a file is open) ---
~$*
