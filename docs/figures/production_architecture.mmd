flowchart TD
    A["Authorized test request + scope<br/>ticket-driven, time-boxed"]:::ext --> B

    subgraph CP["Control plane"]
      B["Identity &amp; Policy Gateway<br/>SSO · RBAC · scope check · change-window"]:::ctrl
      C["Orchestrator / Bounded Agent Planner<br/>budget · policy guard · audit hooks"]:::ctrl
      M["Model Gateway<br/>approved/self-hosted LLM · DLP · prompt+response logging"]:::ctrl
    end

    B -->|denied| X["Block + audit"]:::stop
    B -->|approved| C
    C <--> M
    C --> D{"Allowed tool + target + action?"}:::ctrl
    D -->|no| X
    D -->|yes| E

    subgraph DP["Data plane (isolated)"]
      E["Isolated Scanner Runners<br/>sandboxed · egress-controlled · Nuclei + approved templates"]:::data
    end

    E --> F[("Evidence &amp; Trace Store<br/>immutable, append-only audit log")]:::store
    F --> G["Human Analyst Review<br/>approval gate before any intrusive step"]:::human
    G --> H["Ticketing / Remediation owner<br/>Jira / ServiceNow + SLA"]:::human
    H --> I["Authorized Re-test"]:::human
    I --> C
    F --> J["SIEM / SOC observability"]:::store
    K[["Kill switch / global stop"]]:::stop -.-> C
    K -.-> E

    classDef ctrl fill:#bfdbfe,stroke:#1e40af,color:#111827
    classDef data fill:#fde68a,stroke:#b45309,color:#111827
    classDef human fill:#bbf7d0,stroke:#15803d,color:#111827
    classDef store fill:#e9d5ff,stroke:#7e22ce,color:#111827
    classDef stop fill:#fecaca,stroke:#b91c1c,color:#111827
    classDef ext fill:#e5e7eb,stroke:#4b5563,color:#111827
